# ── 로컬용 템플릿. 복사해서 .env 로 쓰고, .env 는 GitHub에 올리지 않습니다 ──

# Supabase (비워 두면 메모리 임시 저장으로 동작)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 공공데이터포털 인증키 (비워 두면 연습 모드/demo). Decoding 키 권장
DATA_GO_KR_KEY=

# /collect 를 누를 때 쓰는 암호 (직접 정한 긴 문자열)
ADMIN_TOKEN=local-test-token

# 허용할 프론트 주소 (쉼표 구분, 끝에 / 없이)
# 로컬 프론트는 3000 포트 / Railway 배포 시 Vercel 주소로 교체
FRONT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SIDO_NAME=제주
COLLECT_MINUTES=60
